{
  "description": "A DSCPR_* variable set on the agent machine never stands in for an input the step did not set.",
  "workspace": {
    "config": "tests/fixtures/config"
  },
  "environment": {
    "PSModulePath": "{repo}/tests/fixtures/modules"
  },
  "variables": {
    "DSCPR_MODE": "Set",
    "DSCPR_ENGINE": "DscV3"
  },
  "inputs": {
    "configurationPath": "config",
    "skipModuleInstall": "true"
  },
  "expect": {
    "result": "Succeeded",
    "exitCode": 0,
    "call": {
      "Mode": "Test",
      "Engine": "DscV2"
    }
  }
}
