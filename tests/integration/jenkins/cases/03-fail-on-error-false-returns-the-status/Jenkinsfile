@Library('dsc-pipeline-runner') _

node {
    deleteDir()
    sh 'cp -r /repo/tests/fixtures/config config'
    // The stand-in Dsc.PipelineRunner records the arguments it was called with in call.json.
    withEnv(["PSModulePath=/repo/tests/fixtures/modules", "DSCPR_TEST_CALL_FILE=${pwd()}/call.json", "DSCPR_TEST_STATUS=Failed"]) {
        def result = dscPipelineRunner(configurationPath: 'config', skipModuleInstall: true, failOnError: false)
        if (result.status != 'Failed' || result.failCount != 1 || result.passCount != 2) { error "result is ${result}" }
        echo 'CASE-OK'
    }
}
