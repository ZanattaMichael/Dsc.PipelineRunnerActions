@Library('dsc-pipeline-runner') _

node {
    deleteDir()
    sh 'cp -r /repo/tests/fixtures/config config'
    // The stand-in Dsc.PipelineRunner records the arguments it was called with in call.json.
    withEnv(["PSModulePath=/repo/tests/fixtures/modules", "DSCPR_TEST_CALL_FILE=${pwd()}/call.json"]) {
        def result = dscPipelineRunner(
            configurationPath: 'config',
            mode: 'DryRun',
            engine: 'DscV3',
            engineVersion: '3.1.0',
            reportPath: 'out/reports',
            keepTemporaryDirectory: true,
            verbose: true,
            resourceModules: 'DscprTestDependency@1.0.0',
            skipModuleInstall: true
        )
        if (result.status != 'Completed') { error "status is ${result.status}" }
        if (!result.reportPath.endsWith('/out/reports')) { error "reportPath is ${result.reportPath}" }
        if (!fileExists('out/reports/outputs.env')) { error 'the outputs are not in the report path that was asked for' }

        def call = readFile('call.json')
        for (expected in ['"Mode": "DryRun"', '"Engine": "DscV3"', '"EngineVersion": "3.1.0"', '"KeepTemporaryDirectory": true', '"Verbose": true']) {
            if (!call.contains(expected)) { error "expected ${expected} in ${call}" }
        }
        echo 'CASE-OK'
    }
}
