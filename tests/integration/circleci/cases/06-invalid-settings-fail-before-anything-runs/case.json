{
  "description": "Settings the orb cannot check (a revision without a repository URL) are reported by the step in one pass; the job fails with exit code 2 and the module is not called.",
  "workspace": {
    "config": "tests/fixtures/config"
  },
  "environment": {
    "PSModulePath": "{repo}/tests/fixtures/modules"
  },
  "parameters": {
    "configuration-path": "config",
    "configuration-revision": "main",
    "engine-version": "x",
    "skip-module-install": true
  },
  "expect": {
    "status": "failed",
    "exitCode": 2,
    "notCalled": true,
    "outputs": {
      "DSCPR_STATUS": "InvalidSettings"
    },
    "contains": [
      "problem\\(s\\) must be fixed"
    ]
  }
}
