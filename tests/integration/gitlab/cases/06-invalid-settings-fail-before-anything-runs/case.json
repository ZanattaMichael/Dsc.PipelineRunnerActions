{
  "description": "Settings the component cannot check (an Azure DevOps connection without an organization, a module version that is not exact) are reported by the step in one pass; the job fails with exit code 2 and the module is not called.",
  "workspace": {
    "config": "tests/fixtures/config"
  },
  "job": {
    "variables": {
      "PSModulePath": "{repo}/tests/fixtures/modules"
    }
  },
  "inputs": {
    "configuration_path": "config",
    "connect": "AzureDevOps",
    "module_version": "latest",
    "skip_module_install": "true"
  },
  "expect": {
    "status": "failed",
    "exitCode": 2,
    "notCalled": true,
    "dotenv": {
      "DSCPR_STATUS": "InvalidSettings"
    },
    "contains": [
      "'connect' is AzureDevOps but 'azure-devops-organization' is empty",
      "'module-version' is 'latest'",
      "problem\\(s\\) must be fixed"
    ]
  }
}
