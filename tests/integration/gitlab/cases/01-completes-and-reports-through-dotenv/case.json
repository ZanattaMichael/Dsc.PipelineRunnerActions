{
  "description": "A job with only a configuration path runs with the component's defaults, collects the reports as artifacts and passes the result on through the dotenv report.",
  "workspace": {
    "config": "tests/fixtures/config"
  },
  "job": {
    "variables": {
      "PSModulePath": "{repo}/tests/fixtures/modules"
    }
  },
  "inputs": {
    "configuration_path": "config",
    "skip_module_install": "true"
  },
  "expect": {
    "status": "success",
    "exitCode": 0,
    "dotenv": {
      "DSCPR_STATUS": "Completed",
      "DSCPR_TOTAL_RESOURCES": "3",
      "DSCPR_PASS_COUNT": "3",
      "DSCPR_FAIL_COUNT": "0",
      "DSCPR_SKIP_COUNT": "0",
      "DSCPR_MODULE_VERSION": "9.9.9",
      "DSCPR_REPORT_PATH": {
        "matches": "[\\\\/]dsc-reports$"
      }
    },
    "artifacts": [
      "dsc-reports"
    ],
    "call": {
      "Mode": "Test",
      "Engine": "DscV2"
    },
    "contains": [
      "== Dsc\\.PipelineRunner: settings",
      "Platform: gitlab"
    ]
  }
}
