{
  "description": "With skip_module_install, a resource module that is not on the runner is named and the run is aborted.",
  "workspace": {
    "config": "tests/fixtures/config"
  },
  "job": {
    "variables": {
      "PSModulePath": "{repo}/tests/fixtures/modules"
    }
  },
  "inputs": {
    "configuration_path": "config",
    "skip_module_install": "true",
    "resource_modules": "NotOnThisAgent@1.0.0"
  },
  "expect": {
    "status": "failed",
    "exitCode": 1,
    "notCalled": true,
    "dotenv": {
      "DSCPR_STATUS": "Aborted"
    },
    "contains": [
      "Required module\\(s\\) are not installed on the agent: NotOnThisAgent"
    ]
  }
}
